// Função serverless da Vercel — proxy pra OpenRouter com a chave guardada no servidor.

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Método não permitido.' })
  }

  const key = process.env.OPENROUTER_API_KEY
  if (!key) {
    return res.status(500).json({
      error: 'Chave da OpenRouter não configurada. Defina OPENROUTER_API_KEY nas variáveis de ambiente da Vercel.',
    })
  }

  try {
    const { model, system, user, temperature = 0.9, max_tokens = 6000 } = req.body || {}
    if (!model || !user) {
      return res.status(400).json({ error: 'Faltam parâmetros: "model" e "user".' })
    }

    const messages = []
    if (system) messages.push({ role: 'system', content: system })
    messages.push({ role: 'user', content: user })

    const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${key}`,
        'Content-Type': 'application/json',
        'HTTP-Referer': req.headers.origin || 'https://escrivaninha.vercel.app',
        'X-Title': 'Escrivaninha',
      },
      body: JSON.stringify({ model, messages, temperature, max_tokens }),
    })

    const data = await r.json().catch(() => null)

    // A OpenRouter às vezes devolve HTTP 200 com um corpo de erro do provedor.
    const providerError = data?.error?.message || data?.error
    if (!r.ok || providerError) {
      return res.status(r.ok ? 502 : r.status).json({
        error: providerError || `Falha na OpenRouter (HTTP ${r.status}).`,
        detail: data,
      })
    }

    const text = data?.choices?.[0]?.message?.content ?? ''
    if (!text) {
      return res.status(502).json({ error: 'O provedor não retornou texto.', detail: data })
    }
    return res.status(200).json({ text, usage: data?.usage || null })
  } catch (err) {
    return res.status(500).json({ error: String(err?.message || err) })
  }
}
